@PACKAGE_INIT@

# ============================================================================
# ntpliteConfig.cmake
# ----------------------------------------------------------------------------
#   find_package(ntplite CONFIG REQUIRED)
#   target_link_libraries(app PRIVATE ntplite::ntplite)   # header-only, C++
#   target_link_libraries(app PRIVATE ntplite::c)         # prebuilt, C / FFI
# ============================================================================

include(CMakeFindDependencyMacro)

include("${CMAKE_CURRENT_LIST_DIR}/ntpliteTargets.cmake")

check_required_components(ntplite)

set(NTPLITE_VERSION "@PROJECT_VERSION@")
set(NTP_LITE_VERSION "@PROJECT_VERSION@")
